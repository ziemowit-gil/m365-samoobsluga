<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\M365Samoobsluga.Core\M365Samoobsluga.Core.csproj" />
    <ProjectReference Include="..\M365Samoobsluga.Graph\M365Samoobsluga.Graph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageReference Include="Microsoft.Identity.Web.GraphServiceClient" Version="4.16.1" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.16.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Skrypty PowerShell dla Exchange trafiają obok aplikacji (publish), bo uruchamia je panel administratora. -->
    <Content Include="..\..\scripts\Set-StopkaRule.ps1" Link="scripts\Set-StopkaRule.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Clear-UserSignatures.ps1" Link="scripts\Clear-UserSignatures.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Test-ExchangeConnection.ps1" Link="scripts\Test-ExchangeConnection.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\ExoAuth.ps1" Link="scripts\ExoAuth.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
