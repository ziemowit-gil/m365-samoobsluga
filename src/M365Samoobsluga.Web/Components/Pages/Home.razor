@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using M365Samoobsluga.Web.Components.Layout
@inject AuthenticationStateProvider Auth
@inject IAuthorizationService Authz
<PageTitle>Start · Samoobsługa poczty</PageTitle>
<h1>Samoobsługa poczty</h1>
<p class="card-lead">@Greeting Wybierz, co chcesz ustawić. Zmieniasz wyłącznie własne konto.</p>

@foreach (var tab in Tabs)
{
    <section class="card-section" aria-labelledby="ms-@tab.Id">
        <h2 id="ms-@tab.Id">@tab.Title</h2>
        <ul class="card-grid">
            @foreach (var item in tab.Groups.SelectMany(g => g.Items).Where(i => i.Href != ""))
            {
                <li>
                    <a class="card" href="@item.Href">
                        <span class="card-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">@((MarkupString)RibbonDefinition.IconPaths(item.Icon))</svg>
                        </span>
                        <span class="card-label">@item.Label</span>
                        <span class="card-desc">@item.Description</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}
<p class="msg info">Każda zmiana jest zapisywana w dzienniku audytu (kto, co, kiedy). Hasła nie są zapisywane.</p>
@code {
    bool isAdmin; string greeting = "";
    string Greeting => greeting;
    IEnumerable<RibbonTab> Tabs => RibbonDefinition.Tabs.Where(t => isAdmin || !t.AdminOnly);

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        isAdmin = user.Identity?.IsAuthenticated == true && (await Authz.AuthorizeAsync(user, "Admin")).Succeeded;
        var name = user.FindFirst("name")?.Value?.Split('|')[0].Trim();
        greeting = string.IsNullOrWhiteSpace(name) ? "Witaj." : $"Witaj, {name}.";
    }
}
