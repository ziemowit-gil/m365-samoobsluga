@page "/aliasy"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IAliasService Svc
@inject UiGuard Guard
@inject IConfiguration Config
<PageTitle>Aliasy · Samoobsługa poczty</PageTitle>
<h1>Aliasy e-mail</h1>
@if (loading) { <p role="status">Wczytywanie…</p> }
else if (data is not null)
{
<p>Adres główny: <strong>@data.PrimaryAddress</strong></p>
@if (!Svc.AppliesImmediately)
{
    <p class="msg info">Zmiany aliasów wykonuje administrator. Twoja prośba trafi do niego i zacznie działać po jej realizacji.</p>
}
<Status Error="@error" Success="@ok" />
<h2>Dodatkowe aliasy</h2>
@if (data.SecondaryAddresses.Count == 0) { <p>Nie masz dodatkowych aliasów.</p> }
else
{
    <table>
        <caption class="sr-only">Lista aliasów</caption>
        <thead><tr><th scope="col">Adres</th><th scope="col">Działanie</th></tr></thead>
        <tbody>
        @foreach (var a in data.SecondaryAddresses)
        {
            <tr><td>@a</td><td><button type="button" class="secondary" aria-label="Usuń alias @a" @onclick="() => Remove(a)">Usuń</button></td></tr>
        }
        </tbody>
    </table>
}
<h2>Dodaj alias</h2>
<EditForm Model="this" OnSubmit="Add" FormName="alias">
    <div class="field"><label for="lp">Nazwa aliasu (przed znakiem @@)</label><input id="lp" type="text" autocomplete="off" @bind="local" /></div>
    <div class="field"><label for="dom">Domena</label>
        <select id="dom" @bind="domain">
            @foreach (var d in Domains)
            {
                <option value="@d">@d</option>
            }
        </select></div>
    <button type="submit" disabled="@busy">Dodaj</button>
</EditForm>
}
@code {
    IReadOnlyList<string> Domains => AddressValidator.OrderDomains(data?.VerifiedDomains ?? [], Config["Samoobsluga:DefaultAliasDomain"]);
    MailboxAliases? data; bool loading = true, busy; string? error, ok; string local = "", domain = "";
    protected override async Task OnInitializedAsync() { await Load(); loading = false; }
    async Task Load() { error = await Guard.RunAsync(async () => { data = await Svc.GetAsync(); if (domain == "") domain = Domains.FirstOrDefault() ?? ""; }); }
    async Task Add()
    {
        busy = true; ok = null;
        var v = AddressValidator.ValidateAlias(local, domain, data!.VerifiedDomains, data.SecondaryAddresses.Append(data.PrimaryAddress).ToList());
        var outcome = AliasOutcome.Queued;
        error = v.IsValid ? await Guard.RunAsync(async () => outcome = await Svc.AddAsync(v.Normalized!)) : v.Error;
        if (error is null) { ok = outcome == AliasOutcome.Applied ? "Alias dodany. Działa od razu (zmiany w Exchange mogą być widoczne po kilku minutach)." : "Nie mogliśmy dodać aliasu od razu, więc zapisaliśmy wniosek dla administratora."; local = ""; await Load(); }
        busy = false;
    }
    async Task Remove(string a)
    {
        busy = true; ok = null;
        var outcome = AliasOutcome.Queued;
        error = await Guard.RunAsync(async () => outcome = await Svc.RemoveAsync(a));
        if (error is null) { ok = outcome == AliasOutcome.Applied ? "Alias usunięty." : "Nie mogliśmy usunąć aliasu od razu, więc zapisaliśmy wniosek dla administratora."; await Load(); }
        busy = false;
    }
}
