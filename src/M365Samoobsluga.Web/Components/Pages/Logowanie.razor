@page "/logowanie"
@layout LoginLayout
@attribute [AllowAnonymous]
@using M365Samoobsluga.Core.Services
@using M365Samoobsluga.Web.Components.Layout
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IConfiguration Config
<PageTitle>Logowanie · Samoobsługa poczty</PageTitle>
<div class="lm-hero">
    <h1>Samoobsługa poczty Microsoft 365</h1>
    <p class="login-org">Fundacja Edukacji Empatii Rozwoju FEER</p>
</div>
<p class="lm-intro">Ustawisz tu własne konto pocztowe, bez zgłaszania zmian administratorowi:</p>
<ul class="lm-chips">
    <li><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)RibbonDefinition.IconPaths("at"))</svg><span>Aliasy e-mail</span></li>
    <li><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)RibbonDefinition.IconPaths("key"))</svg><span>Hasło</span></li>
    <li><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)RibbonDefinition.IconPaths("shield"))</svg><span>Weryfikacja 2FA</span></li>
    <li><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)RibbonDefinition.IconPaths("pen"))</svg><span>Stopka wiadomości</span></li>
    <li><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)RibbonDefinition.IconPaths("reply"))</svg><span>Autoresponder</span></li>
    <li><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)RibbonDefinition.IconPaths("forward"))</svg><span>Przekierowanie poczty</span></li>
</ul>
<a class="lm-signin" href="@SignInHref">
    <span class="lm-signin-title">Zaloguj się kontem Microsoft 365</span>
    <span class="lm-signin-note">Użyj konta w domenie @Domain. Zmieniasz wyłącznie swoje konto.</span>
    <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h14"/><path d="M13 6l6 6-6 6"/></svg>
</a>
<p class="login-credit">Wykonanie: Jarek P</p>
@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")] public string? ReturnUrl { get; set; }
    string SignInHref => "MicrosoftIdentity/Account/SignIn?redirectUri=" + Uri.EscapeDataString(AzureSetup.SafeReturnUrl(ReturnUrl));
    string Domain => AddressValidator.AliasDomain;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated == true) Nav.NavigateTo(AzureSetup.SafeReturnUrl(ReturnUrl), replace: true);
    }
}
